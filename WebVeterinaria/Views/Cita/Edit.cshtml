@model WebVeterinaria.Dtos.CitaEditDto

@{
    ViewData["Title"] = "Editar Cita";
}

    <div class="content-header">
        <div class="container-fluid">
            <h1>Editar Cita</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="IdCita" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label>Dueño</label>
                            <input type="text"
                                   class="form-control"
                                   value="@ViewBag.NombreDueno"
                                   readonly />
                        </div>

                        <div class="form-group">
                            <label>Mascota</label>
                            <select asp-for="IdMascota" asp-items="ViewBag.Mascotas" class="form-control"></select>
                            <span asp-validation-for="IdMascota" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Veterinario</label>
                            <select asp-for="IdVeterinario" asp-items="ViewBag.Veterinarios" class="form-control"></select>
                            <span asp-validation-for="IdVeterinario" class="text-danger"></span>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Fecha</label>
                                <input asp-for="Fecha" type="date" class="form-control" />
                                <span asp-validation-for="Fecha" class="text-danger"></span>
                            </div>
                            <div class="form-group col-md-6">
                                <label>Hora</label>
                                <input asp-for="Hora" type="time" class="form-control" />
                                <span asp-validation-for="Hora" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Motivo</label>
                            <textarea asp-for="Motivo" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Estado</label>
                            <select asp-for="Estado" asp-items="ViewBag.Estados" class="form-control"></select>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Actualizar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}