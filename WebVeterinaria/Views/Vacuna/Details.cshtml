@model WebVeterinaria.DTOs.VacunaDTO

@{
    ViewData["Title"] = "Detalles";
}

<h1>Detalles</h1>

<div>
    <h4>Vacuna</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Descripción</dt>
        <dd class="col-sm-9">@Model.Descripcion</dd>

        <dt class="col-sm-3">Aplicaciones registradas</dt>
        <dd class="col-sm-9">@Model.CantidadAplicaciones</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdVacuna" class="btn btn-sm btn-warning">Editar</a>
    <a asp-action="Index">Volver a la lista</a>
</div>