@model IEnumerable<WebVeterinaria.DTOs.VeterinarioDTO>

@{
    ViewData["Title"] = "Veterinarios";
}

<h1>Veterinarios</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nuevo</a>
</p>

<form asp-action="Index" method="get" class="mb-3">
    <div class="row">

        <div class="col-md-6">
            <label>Buscar veterinario</label>
            <input type="text"
                   name="busqueda"
                   value="@ViewBag.Busqueda"
                   class="form-control"
                   placeholder="Ingrese DNI o apellido..." />
        </div>

        <div class="col-md-3 d-flex align-items-end">

            <button type="submit" class="btn btn-primary mr-2">
                <i class="fas fa-search"></i>
                Buscar
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Limpiar
            </a>

        </div>

    </div>
</form>

<table class="table table-striped">
    <thead>
        <tr>
            <th>DNI</th>
            <th>Nombres</th>
            <th>Apellidos</th>
            <th>Teléfono</th>
            <th>Correo</th>
            <th>CMVP</th>
            <th>Especialidad</th>
            <th>Estado</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Dni</td>
                <td>@item.Nombres</td>
                <td>@item.Apellidos</td>
                <td>@item.Telefono</td>
                <td>@item.Correo</td>
                <td>@item.Cmpv</td>
                <td>@item.EspecialidadNombre</td>
                <td>@(item.Estado ? "Activo" : "Inactivo")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdVeterinario" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdVeterinario" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.IdVeterinario" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>