@model WebVeterinaria.DTOs.VeterinarioDTO

@{
    ViewData["Title"] = "Detalles del Veterinario";
}

<h1>Detalles</h1>

<div>
    <dl class="row">
        <dt class="col-sm-2">DNI</dt>
        <dd class="col-sm-10">@Model.Dni</dd>

        <dt class="col-sm-2">Nombres</dt>
        <dd class="col-sm-10">@Model.Nombres</dd>

        <dt class="col-sm-2">Apellidos</dt>
        <dd class="col-sm-10">@Model.Apellidos</dd>

        <dt class="col-sm-2">Teléfono</dt>
        <dd class="col-sm-10">@Model.Telefono</dd>

        <dt class="col-sm-2">Correo</dt>
        <dd class="col-sm-10">@Model.Correo</dd>

        <dt class="col-sm-2">CMVP</dt>
        <dd class="col-sm-10">@Model.Cmpv</dd>

        <dt class="col-sm-2">Especialidad</dt>
        <dd class="col-sm-10">@Model.EspecialidadNombre</dd>

        <dt class="col-sm-2">Estado</dt>
        <dd class="col-sm-10">@(Model.Estado ? "Activo" : "Inactivo")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdVeterinario" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>