@model WebVeterinaria.DTOs.DuenoDTO

@{
    ViewData["Title"] = "Eliminar Dueño";
}

<h1>Eliminar</h1>

<h3>¿Estás seguro que deseas eliminar este registro?</h3>

@if (Model.CantidadMascotas > 0)
{
    <div class="alert alert-warning">
        Este dueño tiene <strong>@Model.CantidadMascotas</strong> mascota(s) registrada(s).
        Verifica si la base de datos permite eliminarlo o si conviene desactivarlo en su lugar.
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">DNI</dt>
        <dd class="col-sm-10">@Model.Dni</dd>

        <dt class="col-sm-2">Nombres</dt>
        <dd class="col-sm-10">@Model.Nombres</dd>

        <dt class="col-sm-2">Apellidos</dt>
        <dd class="col-sm-10">@Model.Apellidos</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdDueno" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>