@model IEnumerable<WebVeterinaria.DTOs.EspecieDTO>

@{
    ViewData["Title"] = "Especies";
}

<h1>Especies</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Crear nueva</a>
</p>
<table class="table table-striped">
    <thead>
        <tr>
            <th>Nombre</th>
            <th>Razas registradas</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Nombre</td>
                <td>@item.CantidadRazas</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.IdEspecie" class="btn btn-sm btn-warning">Editar</a>
                    <a asp-action="Details" asp-route-id="@item.IdEspecie" class="btn btn-sm btn-info">Detalles</a>
                    <a asp-action="Delete" asp-route-id="@item.IdEspecie" class="btn btn-sm btn-danger">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>