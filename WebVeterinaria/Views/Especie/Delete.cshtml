@model WebVeterinaria.DTOs.EspecieDTO

@{
    ViewData["Title"] = "Eliminar Especie";
}

<h1>Eliminar</h1>

<h3>¿Estás seguro que deseas eliminar este registro?</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (Model.CantidadRazas > 0)
{
    <div class="alert alert-warning">
        Esta especie tiene <strong>@Model.CantidadRazas</strong> raza(s) asociada(s) y no podrá eliminarse hasta quitarlas primero.
    </div>
}

<div>
    <dl class="row">
        <dt class="col-sm-2">Nombre</dt>
        <dd class="col-sm-10">@Model.Nombre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdEspecie" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>