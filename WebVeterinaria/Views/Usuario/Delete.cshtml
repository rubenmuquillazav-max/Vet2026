@model WebVeterinaria.DTOs.UsuarioDTO

@{
    ViewData["Title"] = "Eliminar Usuario";
}

<h1>Eliminar</h1>

<h3>¿Estás seguro que deseas eliminar este registro?</h3>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div>
    <dl class="row">
        <dt class="col-sm-3">Usuario</dt>
        <dd class="col-sm-9">@Model.Usuario</dd>

        <dt class="col-sm-3">Nombres</dt>
        <dd class="col-sm-9">@Model.Nombres @Model.Apellidos</dd>

        <dt class="col-sm-3">Rol</dt>
        <dd class="col-sm-9">@Model.RolNombre</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="IdUsuario" />
        <button type="submit" class="btn btn-danger">Eliminar</button>
        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
    </form>
</div>