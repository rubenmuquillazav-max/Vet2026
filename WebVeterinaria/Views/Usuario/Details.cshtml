@model WebVeterinaria.DTOs.UsuarioDTO

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<h1>Detalles</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Usuario</dt>
        <dd class="col-sm-9">@Model.Usuario</dd>

        <dt class="col-sm-3">Nombres</dt>
        <dd class="col-sm-9">@Model.Nombres</dd>

        <dt class="col-sm-3">Apellidos</dt>
        <dd class="col-sm-9">@Model.Apellidos</dd>

        <dt class="col-sm-3">Correo</dt>
        <dd class="col-sm-9">@Model.Correo</dd>

        <dt class="col-sm-3">Rol</dt>
        <dd class="col-sm-9">@Model.RolNombre</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@(Model.Estado ? "Activo" : "Inactivo")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>