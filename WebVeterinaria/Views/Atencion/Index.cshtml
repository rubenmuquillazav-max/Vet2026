@model List<WebVeterinaria.DTOs.AtencionListDto>

@{
    ViewData["Title"] = "Historias Clínicas";
}

    <div class="content-header">
        <div class="container-fluid">
            <div class="row mb-2">
                <div class="col-sm-6">
                    <h1>Historias Clínicas</h1>
                </div>
                <div class="col-sm-6 text-right">
                    <a asp-action="Create" class="btn btn-primary">
                        <i class="fas fa-plus"></i> Nueva Atención
                    </a>
                </div>
            </div>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            @if (TempData["Success"] != null)
            {
                <div class="alert alert-success alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert">&times;</button>
                    @TempData["Success"]
                </div>
            }

            <div class="card">
                <div class="card-body">
                    <table class="table table-bordered table-striped">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Mascota</th>
                                <th>Veterinario</th>
                                <th>Fecha</th>
                                <th>Diagnóstico</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.IdAtencion</td>
                                    <td>@item.NombreMascota</td>
                                    <td>@item.NombreVeterinario</td>
                                    <td>@item.Fecha?.ToString("dd/MM/yyyy HH:mm")</td>
                                    <td>@item.Diagnostico</td>
                                    <td class="text-center">
                                        <a asp-action="Details" asp-route-id="@item.IdAtencion" class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>
                                        <a asp-action="Edit" asp-route-id="@item.IdAtencion" class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.IdAtencion" class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>