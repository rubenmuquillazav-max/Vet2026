@model WebVeterinaria.DTOs.AtencionEditDto

@{
    ViewData["Title"] = "Editar Atención";
}


    <div class="content-header">
        <div class="container-fluid">
            <h1>Editar Atención</h1>
        </div>
    </div>

    <section class="content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="IdAtencion" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-group">
                            <label>Cita</label>
                            <select asp-for="IdCita" asp-items="ViewBag.Citas" class="form-control"></select>
                            <span asp-validation-for="IdCita" class="text-danger"></span>
                        </div>

                        <div class="form-row">
                            <div class="form-group col-md-6">
                                <label>Temperatura (°C)</label>
                                <input asp-for="Temperatura" type="number" step="0.1" class="form-control" />
                            </div>
                            <div class="form-group col-md-6">
                                <label>Peso (kg)</label>
                                <input asp-for="Peso" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group">
                            <label>Diagnóstico</label>
                            <textarea asp-for="Diagnostico" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Diagnostico" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label>Tratamiento</label>
                            <textarea asp-for="Tratamiento" class="form-control" rows="3"></textarea>
                        </div>

                        <div class="form-group">
                            <label>Observaciones</label>
                            <textarea asp-for="Observaciones" class="form-control" rows="3"></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary">
                            <i class="fas fa-save"></i> Actualizar
                        </button>
                        <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                    </form>
                </div>
            </div>
        </div>
    </section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}