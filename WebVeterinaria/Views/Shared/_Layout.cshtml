<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - Veterinaria</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6/css/all.min.css">

    
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/css/adminlte.min.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@fortawesome/fontawesome-free@6/css/all.min.css">
<style>
    :root {
        --vet-primary: #0d8a6f;
        --vet-primary-dark: #096b56;
    }

    .main-sidebar {
        background-color: var(--vet-primary-dark) !important;
    }

    .nav-sidebar .nav-link.active,
    .nav-sidebar .nav-link:hover {
        background-color: var(--vet-primary) !important;
    }

    .brand-link {
        background-color: var(--vet-primary-dark) !important;
        border-bottom: 1px solid rgba(255,255,255,0.15);
    }

    .navbar-white {
        border-bottom: 3px solid var(--vet-primary) !important;
    }

    .btn-primary {
        background-color: var(--vet-primary) !important;
        border-color: var(--vet-primary) !important;
    }
</style>

    


</head>
<body class="sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar superior -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars"></i></a>
                </li>
            </ul>
            <ul class="navbar-nav ml-auto">
                <li class="nav-item">
                    <span class="nav-link">@Context.Session.GetString("NombreUsuario") (@Context.Session.GetString("Rol"))</span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" asp-controller="Login" asp-action="Logout">
                        <i class="fas fa-sign-out-alt"></i> Salir
                    </a>
                </li>
            </ul>
        </nav>

        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-success elevation-4">
            <a href="#" class="brand-link">
                <span class="brand-text font-weight-light ml-2">🐾 Veterinaria</span>
            </a>
            <div class="sidebar">
                <nav class="mt-2">
                    <ul class="nav nav-pills nav-sidebar flex-column" role="menu">

                        <li class="nav-item">
                            <a asp-controller="Dashboard" asp-action="Index" class="nav-link">
                                <i class="nav-icon fas fa-tachometer-alt"></i>
                                <p>Inicio</p>
                            </a>
                        </li>

                        @{
                            var rol = Context.Session.GetString("Rol");
                        }

                        @if (rol == "Administrador" || rol == "Recepcionista")
                        {
                            <li class="nav-item">
                                <a asp-controller="Dueno" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-user"></i>
                                    <p>Dueños</p>
                                </a>
                            </li>
                        }

                        @if (rol == "Administrador" || rol == "Veterinario" || rol == "Recepcionista")
                        {
                            <li class="nav-item">
                                <a asp-controller="Mascota" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-paw"></i>
                                    <p>Mascotas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Cita" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-calendar-check"></i>
                                    <p>Citas</p>
                                </a>
                            </li>
                        }

                        @if (rol == "Administrador" || rol == "Veterinario")
                        {
                            <li class="nav-item">
                                <a asp-controller="Atencion" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-stethoscope"></i>
                                    <p>Atenciones</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="MascotaVacuna" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-syringe"></i>
                                    <p>Mascota - Vacunas</p>
                                </a>
                            </li>
                        }

                        @if (rol == "Administrador")
                        {
                            <li class="nav-header">ADMINISTRACIÓN</li>
                            <li class="nav-item">
                                <a asp-controller="Especie" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-dna"></i>
                                    <p>Especies</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Raza" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-list"></i>
                                    <p>Razas</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Veterinario" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-user-md"></i>
                                    <p>Veterinarios</p>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a asp-controller="Especialidad" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-briefcase-medical"></i>
                                    <p>Especialidades</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Vacuna" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-syringe"></i>
                                    <p>Vacunas</p>
                                </a>
                            </li>

                            <li class="nav-item">
                                <a asp-controller="Usuario" asp-action="Index" class="nav-link">
                                    <i class="nav-icon fas fa-users-cog"></i>
                                    <p>Usuarios</p>
                                </a>
                            </li>
                        }

                    </ul>
                </nav>
            </div>
        </aside>

        <!-- Contenido principal -->
        <div class="content-wrapper">
            <section class="content">
                <div class="container-fluid mt-3">
                    @RenderBody()
                </div>
            </section>
        </div>

    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/admin-lte@3.2/dist/js/adminlte.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>