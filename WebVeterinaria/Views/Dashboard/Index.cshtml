@{
    ViewData["Title"] = "Dashboard";
}

<h1>Bienvenido, @ViewBag.NombreUsuario</h1>
<p class="text-muted">Rol: @ViewBag.Rol</p>

<!-- RESUMEN GENERAL -->
<div class="row mt-4">

    <!-- DUEÑOS -->
    <div class="col-md-3">
        <div class="card bg-primary text-white">
            <div class="card-body">
                <h5>
                    <i class="fas fa-users"></i>
                    Dueños
                </h5>

                <h2>@ViewBag.TotalDuenos</h2>

                <p class="mb-0">
                    Dueños activos
                </p>
            </div>
        </div>
    </div>

    <!-- MASCOTAS -->
    <div class="col-md-3">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5>
                    <i class="fas fa-paw"></i>
                    Mascotas
                </h5>

                <h2>@ViewBag.TotalMascotas</h2>

                <p class="mb-0">
                    Mascotas activas
                </p>
            </div>
        </div>
    </div>

    <!-- CITAS -->
    <div class="col-md-3">
        <div class="card bg-warning text-dark">
            <div class="card-body">
                <h5>
                    <i class="fas fa-calendar-alt"></i>
                    Citas de hoy
                </h5>

                <h2>@ViewBag.CitasHoy</h2>

                <p class="mb-0">
                    Citas programadas
                </p>
            </div>
        </div>
    </div>

    <!-- VETERINARIOS -->
    <div class="col-md-3">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5>
                    <i class="fas fa-user-md"></i>
                    Veterinarios
                </h5>

                <h2>@ViewBag.TotalVeterinarios</h2>

                <p class="mb-0">
                    Veterinarios activos
                </p>
            </div>
        </div>
    </div>

</div>


<!-- ESTADOS DE CITAS -->
<div class="row mt-4">

    <!-- PENDIENTES -->
    <div class="col-md-4">
        <div class="card border-warning">
            <div class="card-body">

                <h5 class="text-warning">
                    <i class="fas fa-clock"></i>
                    Citas pendientes
                </h5>

                <h2>
                    @ViewBag.CitasPendientes
                </h2>

                <p class="text-muted mb-0">
                    Pendientes para hoy
                </p>

            </div>
        </div>
    </div>

    <!-- ATENDIDAS -->
    <div class="col-md-4">
        <div class="card border-success">
            <div class="card-body">

                <h5 class="text-success">
                    <i class="fas fa-check-circle"></i>
                    Citas atendidas
                </h5>

                <h2>
                    @ViewBag.CitasAtendidas
                </h2>

                <p class="text-muted mb-0">
                    Atendidas hoy
                </p>

            </div>
        </div>
    </div>

    <!-- CANCELADAS -->
    <div class="col-md-4">
        <div class="card border-danger">
            <div class="card-body">

                <h5 class="text-danger">
                    <i class="fas fa-times-circle"></i>
                    Citas canceladas
                </h5>

                <h2>
                    @ViewBag.CitasCanceladas
                </h2>

                <p class="text-muted mb-0">
                    Canceladas hoy
                </p>

            </div>
        </div>
    </div>

</div>