@model WebVeterinaria.DTOs.MascotaDTO

@{
    ViewData["Title"] = "Detalles de la Mascota";
}

<h1>Detalles</h1>

<div>
    <dl class="row">
        <dt class="col-sm-3">Nombre</dt>
        <dd class="col-sm-9">@Model.Nombre</dd>

        <dt class="col-sm-3">Dueño</dt>
        <dd class="col-sm-9">@Model.DuenoNombreCompleto</dd>

        <dt class="col-sm-3">Especie</dt>
        <dd class="col-sm-9">@Model.EspecieNombre</dd>

        <dt class="col-sm-3">Raza</dt>
        <dd class="col-sm-9">@Model.RazaNombre</dd>

        <dt class="col-sm-3">Fecha de nacimiento</dt>
        <dd class="col-sm-9">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "-")</dd>

        <dt class="col-sm-3">Sexo</dt>
        <dd class="col-sm-9">@Model.Sexo</dd>

        <dt class="col-sm-3">Color</dt>
        <dd class="col-sm-9">@Model.Color</dd>

        <dt class="col-sm-3">Peso (kg)</dt>
        <dd class="col-sm-9">@Model.Peso</dd>

        <dt class="col-sm-3">Alergias</dt>
        <dd class="col-sm-9">@(Model.Alergias ?? "-")</dd>

        <dt class="col-sm-3">Observaciones</dt>
        <dd class="col-sm-9">@(Model.Observaciones ?? "-")</dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">@(Model.Estado ? "Activo" : "Inactivo")</dd>
    </dl>
</div>
<div>
    <a asp-action="Edit" asp-route-id="@Model.IdMascota" class="btn btn-warning">Editar</a>
    <a asp-action="Index" class="btn btn-secondary">Volver a la lista</a>
</div>