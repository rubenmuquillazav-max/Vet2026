@model WebVeterinaria.DTOs.MascotaVacunaCreateDTO

<h1>Registrar Vacuna</h1>

<form asp-action="Create" method="post">

    <div class="form-group">
        <label for="IdDueno">
            Dueño
            <span class="text-danger">*</span>
        </label>

        <select id="IdDueno"
                name="IdDueno"
                class="form-control"
                asp-items="ViewBag.Duenos">

            <option value="">
                -- Seleccione un dueño --
            </option>

        </select>

        <small class="form-text text-muted">
            Seleccione primero el dueño de la mascota.
        </small>
    </div>

    <div class="form-group">
        <label asp-for="IdMascota">
            Mascota
            <span class="text-danger">*</span>
        </label>

        <select asp-for="IdMascota"
                id="IdMascota"
                class="form-control"
                disabled>

            <option value="">
                -- Seleccione primero un dueño --
            </option>
        </select>

        <span asp-validation-for="IdMascota"
              class="text-danger">
        </span>
    </div>

    <div class="form-group">
        <label>Vacuna</label>

        <select asp-for="IdVacuna"
                asp-items="ViewBag.Vacunas"
                class="form-control">

            <option value="">-- Seleccione una vacuna --</option>

        </select>

        <span asp-validation-for="IdVacuna"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Fecha de aplicación</label>

        <input asp-for="Fecha"
               type="date"
               class="form-control" />

        <span asp-validation-for="Fecha"
              class="text-danger"></span>
    </div>

    <div class="form-group">
        <label>Próxima dosis</label>

        <input asp-for="ProximaDosis"
               type="date"
               class="form-control" />
    </div>

    <div class="form-group">
        <label>Observaciones</label>

        <textarea asp-for="Observaciones"
                  class="form-control"
                  rows="3"></textarea>
    </div>

    <button type="submit" class="btn btn-primary">
        <i class="fas fa-save"></i>
        Registrar vacuna
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Cancelar
    </a>

</form>

<script>
    document.getElementById("IdDueno").addEventListener("change", function () {

        const idDueno = this.value;
        const mascotaSelect = document.getElementById("IdMascota");

        mascotaSelect.innerHTML = "";

        if (!idDueno) {

            mascotaSelect.innerHTML =
                '<option value="">-- Seleccione primero un dueño --</option>';

            mascotaSelect.disabled = true;

            return;
        }

        mascotaSelect.innerHTML =
            '<option value="">Cargando mascotas...</option>';

        mascotaSelect.disabled = true;

        fetch('@Url.Action("ObtenerMascotasPorDueno", "MascotaVacuna")?idDueno=' + idDueno)

            .then(response => response.json())

            .then(data => {

                mascotaSelect.innerHTML =
                    '<option value="">-- Seleccione una mascota --</option>';

                if (data.length === 0) {

                    mascotaSelect.innerHTML =
                        '<option value="">Este dueño no tiene mascotas</option>';

                    mascotaSelect.disabled = true;

                    return;
                }

                data.forEach(mascota => {

                    const option = document.createElement("option");

                    option.value = mascota.idMascota;
                    option.textContent = mascota.nombre;

                    mascotaSelect.appendChild(option);
                });

                mascotaSelect.disabled = false;
            })

            .catch(error => {

                console.error(error);

                mascotaSelect.innerHTML =
                    '<option value="">Error al cargar mascotas</option>';

                mascotaSelect.disabled = true;
            });
    });
</script>